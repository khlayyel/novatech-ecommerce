# ── Image du frontend React (build Vite + serveur nginx) ─────────
# Build (à la racine du projet) : docker build -f Dockerfile.frontend -t novatech-web \
#   --build-arg VITE_API_URL=http://localhost:5000/api \
#   --build-arg VITE_STRIPE_PUBLIC_KEY=pk_test_xxx .

FROM node:22-alpine AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Variables publiques injectées au moment du build Vite
ARG VITE_API_URL
ARG VITE_STRIPE_PUBLIC_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STRIPE_PUBLIC_KEY=$VITE_STRIPE_PUBLIC_KEY

COPY frontend/ ./
RUN npm run build

# ── Étape de service : nginx ─────────────────────────────────────
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
