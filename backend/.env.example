# Environnement : development | test | production
NODE_ENV=development

# Port du serveur Express
PORT=5000

# Chaîne de connexion MongoDB (locale ou MongoDB Atlas)
MONGODB_URI=

# Clés Stripe en MODE TEST uniquement (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secret de signature des jetons JWT (générez une longue chaîne aléatoire)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origines autorisées par CORS (séparées par des virgules)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Assistant IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
